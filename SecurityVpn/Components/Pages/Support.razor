@page "/support"
@implements IDisposable
@using VPN.Services
@inject LocalizationService Loc

<div class="support-page">

    <header class="support-hero">
        <div class="support-hero-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        </div>
        <h2>@Loc.T("support.title")</h2>
        <p>@Loc.T("support.subtitle")</p>
    </header>

    <div class="support-body">

        <div class="contact-card">
            <div class="contact-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            </div>
            <div class="contact-text">
                <div class="contact-title">@Loc.T("support.contact.title")</div>
                <div class="contact-sub">@Loc.T("support.contact.sub")</div>
            </div>
            <button type="button" class="contact-btn" @onclick="OpenChat">@Loc.T("support.contact.button")</button>
        </div>

        <span class="support-section-title">@Loc.T("support.faqTitle")</span>
        <div class="faq-list">
            @for (int i = 0; i < faqKeys.Count; i++)
            {
                var index = i;
                var (qKey, aKey) = faqKeys[index];
                <div class="faq-card @(openIndex == index ? "open" : "")">
                    <button type="button" class="faq-question" @onclick="() => ToggleFaq(index)">
                        <span>@Loc.T(qKey)</span>
                        <span class="faq-chevron">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </span>
                    </button>
                    @if (openIndex == index)
                    {
                        <div class="faq-answer">@Loc.T(aKey)</div>
                    }
                </div>
            }
        </div>

        <div class="support-links">
            <a href="javascript:void(0)">@Loc.T("support.links.telegram")</a><span class="dot">•</span>
            <a href="javascript:void(0)">@Loc.T("support.links.email")</a><span class="dot">•</span>
            <a href="javascript:void(0)">@Loc.T("support.links.site")</a>
        </div>
        <div class="app-version">Security VPN v1.0.0</div>
    </div>
</div>

@code {
    private int? openIndex;

    private List<(string QuestionKey, string AnswerKey)> faqKeys = new()
    {
        ("support.faq.q1", "support.faq.a1"),
        ("support.faq.q2", "support.faq.a2"),
        ("support.faq.q3", "support.faq.a3"),
        ("support.faq.q4", "support.faq.a4"),
        ("support.faq.q5", "support.faq.a5"),
    };

    protected override void OnInitialized()
    {
        Loc.OnChange += HandleLanguageChanged;
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private void ToggleFaq(int index)
    {
        openIndex = openIndex == index ? null : index;
    }

    private void OpenChat()
    {
        // TODO: интеграция с реальным чатом поддержки
    }

    public void Dispose()
    {
        Loc.OnChange -= HandleLanguageChanged;
    }
}
