@using Microsoft.AspNetCore.Components.Web
@using System.Linq
@page "/profile"
@implements IDisposable
@inject AuthService AuthService
@inject NodeStorage ns
@inject VpnController Vpn
@inject VpnSettingsService Settings
@inject NavigationManager Nav
@inject LocalizationService Loc

<div class="profile-container">

    <div class="hero-section">
        <div class="hero-bg-circle"></div>

        <div class="md-hidden">
            <button @onclick='() => Nav.NavigateTo("/")' class="back-button">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(90deg);"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
        </div>

        <div class="user-name">@(AuthService.UserName ?? Loc.T("profile.defaultUser"))</div>
        <div class="user-email">@Loc.T("profile.plan.sub")</div>

        <button @onclick='() => Nav.NavigateTo("/subscription")' class="pro-plan-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7z"></path></svg>
            <span class="pro-text">@Loc.T("profile.badge")</span>
        </button>

        <div class="expiry-text">
            @Loc.T("profile.since") <span class="expiry-date">@(AuthService.RegisteredAt?.ToString("d MMMM yyyy", Loc.Culture) ?? "—")</span>
        </div>
    </div>

    <div class="stats-wrapper">
        <div class="stats-grid">
            <div class="stat-item border-right">
                <div class="stat-value">@servers</div>
                <div class="stat-label">@Loc.T("profile.stat.servers")</div>
            </div>
            <div class="stat-item border-right">
                <div class="stat-value">@days</div>
                <div class="stat-label">@Loc.T("profile.stat.days")</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">@Fmt.Bytes(Vpn.TotalDown + Vpn.TotalUp, Loc)</div>
                <div class="stat-label">@Loc.T("profile.stat.protected")</div>
            </div>
        </div>
    </div>

    <div class="content-padding">
        <div class="card border-blue">
            <div class="chart-header">
                <div class="chart-title">@Loc.T("profile.traffic.title")</div>
                <div class="chart-legend">
                    <div class="legend-item">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><line x1="17" y1="7" x2="7" y2="17"></line><polyline points="17 17 7 17 7 7"></polyline></svg>
                        <span class="legend-value">@FormatGb(totalDownload)</span>
                    </div>
                    <div class="legend-item">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                        <span class="legend-value">@FormatGb(totalUpload)</span>
                    </div>
                </div>
            </div>

            <div class="chart-day-detail">
                <span class="chart-day-detail-name">@Loc.T(weekDayFullKeys[selectedIndex])</span>
                <span class="chart-day-detail-total">@FormatGb(trafficValues[selectedIndex])</span>
                <span class="chart-day-detail-split">
                    <span class="dot dot-down"></span>@Loc.T("profile.traffic.download") @FormatGb(downloadGb[selectedIndex])
                    <span class="dot dot-up"></span>@Loc.T("profile.traffic.upload") @FormatGb(uploadGb[selectedIndex])
                </span>
            </div>

            <div class="chart-bars">
                @for (int i = 0; i < trafficValues.Length; i++)
                {
                    var idx = i;
                    var dayName = Loc.T(weekDayKeys[idx]);
                    var isSelected = idx == selectedIndex;
                    var heightPercent = (trafficValues[idx] / maxTraffic) * 100;

                    <button type="button"
                            class="bar-wrapper @(isSelected ? "is-selected" : "")"
                            @onclick="() => SelectDay(idx)"
                            aria-label="@dayName">
                        <div class="bar @(isSelected ? "bar-special" : "bar-default")"
                             style="height: @($"{heightPercent:F1}%");">
                        </div>
                        <span class="bar-label">@dayName</span>
                    </button>
                }
            </div>
            <div class="chart-hint">@Loc.T("profile.traffic.tapHint")</div>
            <div class="chart-hint">@Loc.T("profile.traffic.sample")</div>
        </div>
    </div>

    <div class="content-padding space-y-2 pb-4">

        <button @onclick='() => Nav.NavigateTo("/subscription")' class="menu-button">
            <div class="icon-wrapper bg-blue-light text-blue-main">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            </div>
            <div class="menu-text">
                <div class="menu-label">@Loc.T("profile.menu.subscription")</div>
                <div class="menu-sub">@Loc.T("profile.menu.subscription.sub")</div>
            </div>
            <svg class="chevron-right" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>

        <button @onclick='() => Nav.NavigateTo("/support")' class="menu-button">
            <div class="icon-wrapper bg-purple-light text-purple-main">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </div>
            <div class="menu-text">
                <div class="menu-label">@Loc.T("profile.menu.support")</div>
                <div class="menu-sub">@Loc.T("profile.menu.support.sub")</div>
            </div>
            <svg class="chevron-right" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>

        <button @onclick='() => Nav.NavigateTo("/settings")' class="menu-button">
            <div class="icon-wrapper bg-orange-light text-orange-main">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            </div>
            <div class="menu-text">
                <div class="menu-label">@Loc.T("profile.menu.settings")</div>
                <div class="menu-sub">@Loc.T("profile.menu.settings.sub")</div>
            </div>
            <svg class="chevron-right" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>

        <div class="toggle-item">
            <div class="icon-wrapper bg-green-light text-green-main">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            </div>
            <div class="menu-text">
                <div class="menu-label">@Loc.T("profile.notifications")</div>
                <div class="menu-sub">@Loc.T(notif ? "profile.notifications.on" : "profile.notifications.off")</div>
            </div>
            <label class="switch">
                <input type="checkbox" checked="@notif" @onchange="ToggleNotif" />
                <span class="slider round bg-green-switch"></span>
            </label>
        </div>

        <div class="toggle-item">
            <div class="icon-wrapper bg-blue-light text-blue-main">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <div class="menu-text">
                <div class="menu-label">@Loc.T("profile.killswitch")</div>
                <div class="menu-sub">@Loc.T(kill ? "profile.killswitch.on" : "profile.killswitch.off")</div>
            </div>
            <label class="switch">
                <input type="checkbox" checked="@kill" @onchange="ToggleKill" />
                <span class="slider round bg-blue-switch"></span>
            </label>
        </div>

        <button @onclick="Logout" class="logout-button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>@Loc.T("profile.logout")</span>
        </button>

    </div>
</div>

@code {
    private bool notif = true;
    private bool kill => Settings.KillSwitch;
    private int days => Math.Max(1, (int)(DateTime.Now - (AuthService.RegisteredAt ?? DateTime.Now)).TotalDays + 1);
    private int servers => ns.All.Count;

    // Трафик по дням: скачано/отправлено (ГБ). trafficValues — сумма, для высоты столбцов.
    private double[] downloadGb = { 2.9, 5.4, 2.0, 6.6, 3.9, 7.8, 4.2 };
    private double[] uploadGb = { 1.3, 2.4, 1.1, 2.8, 1.7, 3.4, 2.1 };
    private double[] trafficValues => downloadGb.Select((d, i) => d + uploadGb[i]).ToArray();
    private double totalDownload => downloadGb.Sum();
    private double totalUpload => uploadGb.Sum();
    private double maxTraffic => Math.Max(trafficValues.Max(), 0.1);

    private string[] weekDayKeys = { "profile.day.mon", "profile.day.tue", "profile.day.wed", "profile.day.thu", "profile.day.fri", "profile.day.sat", "profile.day.sun" };
    private string[] weekDayFullKeys = { "profile.day.mon.full", "profile.day.tue.full", "profile.day.wed.full", "profile.day.thu.full", "profile.day.fri.full", "profile.day.sat.full", "profile.day.sun.full" };

    // По умолчанию выделяем сегодняшний день недели.
    // weekDayKeys начинается с понедельника (индекс 0) и заканчивается
    // воскресеньем (индекс 6), а DateTime.DayOfWeek — с воскресенья (0),
    // поэтому переводим одно в другое: вс(0)->6, пн(1)->0, ..., сб(6)->5.
    private int selectedIndex = ((int)DateTime.Now.DayOfWeek + 6) % 7;

    private void SelectDay(int index) => selectedIndex = index;

    private string FormatGb(double gb) => $"{gb:F1} {(Loc.CurrentLanguage == AppLanguage.En ? "GB" : "ГБ")}";

    protected override void OnInitialized()
    {
        Loc.OnChange += HandleLanguageChanged;
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private void Logout()
    {
        AuthService.Logout();
        Nav.NavigateTo("/login");
    }
    private void ToggleNotif() => notif = !notif;
    private void ToggleKill() => Settings.SetKillSwitch(!Settings.KillSwitch);

    public void Dispose()
    {
        Loc.OnChange -= HandleLanguageChanged;
    }
}
