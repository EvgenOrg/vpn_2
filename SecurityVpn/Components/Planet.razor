@implements IAsyncDisposable
@inject IJSRuntime JS

<canvas @ref="_canvas" class="planet-canvas"></canvas>

@code {
    /// <summary>idle | connecting | connected — влияет на цвет, дугу соединения и поворот к серверу.</summary>
    [Parameter]
    public string State { get; set; } = "idle";

    /// <summary>ISO-код страны сервера; null — сервера нет, планета просто вращается.</summary>
    [Parameter]
    public string? Country { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private int _id = -1;
    private string? _pushedState;
    private string? _pushedCountry;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/planet.js");
            _id = await _module.InvokeAsync<int>("create", _canvas);
        }

        await PushAsync();
    }

    private async Task PushAsync()
    {
        if (_module is null || _id < 0) return;

        if (_pushedState != State)
        {
            _pushedState = State;
            await _module.InvokeVoidAsync("setState", _id, State);
        }

        if (_pushedCountry != Country)
        {
            _pushedCountry = Country;
            if (CountryCoords.TryGet(Country, out var lat, out var lon))
                await _module.InvokeVoidAsync("setServer", _id, lat, lon);
            else
                await _module.InvokeVoidAsync("clearServer", _id);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                if (_id >= 0) await _module.InvokeVoidAsync("dispose", _id);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // WebView уже закрыт
        }
    }
}
