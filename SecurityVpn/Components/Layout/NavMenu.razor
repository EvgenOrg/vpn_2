@implements IDisposable
@using VPN.Services
@using Microsoft.Maui.Devices
@inject NavigationManager Nav
@inject AuthService AuthService
@inject LocalizationService Loc

<nav class="nav-menu">
    <div class="nav-menu-glass @(IsAndroid ? "nav-flat" : "")">
        <div class="nav-indicator" style="--idx:@ActiveIndex" hidden="@(ActiveIndex < 0)"></div>

        <div class="nav-item">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link">
                <span class="nav-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 6v6c0 5 3.8 8.4 9 10 5.2-1.6 9-5 9-10V6l-9-4z"></path></svg>
                </span>
                <span class="nav-label">@Loc.T("nav.home")</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink href="/servers" class="nav-link">
                <span class="nav-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                </span>
                <span class="nav-label">@Loc.T("nav.servers")</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink href="/subscription" class="nav-link">
                <span class="nav-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7z"></path></svg>
                </span>
                <span class="nav-label">@Loc.T("nav.subscription")</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink href="/settings" class="nav-link">
                <span class="nav-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                </span>
                <span class="nav-label">@Loc.T("nav.settings")</span>
            </NavLink>
        </div>

        <button type="button" class="nav-item nav-avatar-item @(IsProfileGroupActive ? "active" : "")" @onclick="ToggleMenu">
            <span class="nav-avatar">@Initials</span>
            <span class="nav-label">@Loc.T("nav.profile")</span>
        </button>
    </div>
</nav>

@if (menuOpen)
{
    <div class="nav-backdrop" @onclick="CloseMenu"></div>
    <div class="nav-dropdown @(IsAndroid ? "nav-flat" : "")">
        <div class="nav-dropdown-header">
            <div class="nav-dropdown-avatar">@Initials</div>
            <div class="nav-dropdown-userinfo">
                <div class="nav-dropdown-name">@(AuthService.UserName ?? Loc.T("nav.user.default"))</div>
                <div class="nav-dropdown-email">@Loc.T("nav.plan")</div>
            </div>
        </div>

        <button type="button" class="nav-dropdown-item" @onclick='() => Navigate("/profile")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>@Loc.T("nav.profile")</span>
        </button>
        <button type="button" class="nav-dropdown-item" @onclick='() => Navigate("/subscription")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7z"></path></svg>
            <span>@Loc.T("nav.dropdown.subscription")</span>
        </button>
        <button type="button" class="nav-dropdown-item" @onclick='() => Navigate("/support")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            <span>@Loc.T("nav.dropdown.support")</span>
        </button>

        <div class="nav-dropdown-divider"></div>

        <button type="button" class="nav-dropdown-item danger" @onclick="DoLogout">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>@Loc.T("nav.dropdown.logout")</span>
        </button>
    </div>
}

@code {
    // Android WebView (Chromium) плохо и очень дорого по GPU обрабатывает
    // backdrop-filter: blur() у fixed-элемента поверх длинных скроллящихся
    // страниц (Profile — самая длинная в приложении). Из-за этого на
    // скруглённых углах навбара остаётся паразитная "обводка"-хало от блюра,
    // а во время/после скролла WebView теряет тач-события на nav-menu —
    // выглядит как "навбар завис, из профиля не выйти". На Android поэтому
    // полностью убираем blur (см. .nav-flat в NavMenu.razor.css).
    private static bool IsAndroid => DeviceInfo.Current.Platform == DevicePlatform.Android;

    private bool menuOpen;
    private string currentPath = "/";

    protected override void OnInitialized()
    {
        currentPath = GetPath(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
        Loc.OnChange += HandleLanguageChanged;
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentPath = GetPath(e.Location);
        menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private string GetPath(string uri)
    {
        var relative = "/" + Nav.ToBaseRelativePath(uri);
        var qIndex = relative.IndexOf('?');
        return qIndex >= 0 ? relative[..qIndex] : relative;
    }

    private int ActiveIndex => currentPath switch
    {
        "/" => 0,
        "/servers" => 1,
        "/subscription" => 2,
        "/settings" => 3,
        "/profile" or "/support" => 4,
        _ => -1
    };

    private bool IsProfileGroupActive => currentPath is "/profile" or "/support";

    private string Initials
    {
        get
        {
            var name = AuthService.UserName;
            if (string.IsNullOrWhiteSpace(name)) return "??";
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2
                ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
                : name[..Math.Min(2, name.Length)].ToUpper();
        }
    }

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;

    private void Navigate(string url)
    {
        menuOpen = false;
        Nav.NavigateTo(url);
    }

    private void DoLogout()
    {
        menuOpen = false;
        AuthService.Logout();
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Loc.OnChange -= HandleLanguageChanged;
    }
}
