@inject AuthService AuthService
@inject NavigationManager Nav
@inject LocalizationService Loc

<div class="auth-form">
    <div class="auth-input">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        <input type="text"
               autocomplete="username"
               placeholder="@Loc.T("auth.login.placeholder")"
               @bind="login"
               @bind:event="oninput" />
    </div>

    <PasswordInput OnInputPassword="PasswordChanged"
                   OnSubmit="DoLogin"
                   PlaceHolder="@Loc.T("auth.password.placeholder")" />

    <div class="auth-options">
        <label class="auth-checkbox">
            <input type="checkbox" @bind="rememberMe" />
            <span>@Loc.T("auth.remember")</span>
        </label>
    </div>

    <button type="button" class="auth-submit-btn" @onclick="DoLogin" disabled="@isBusy">
        @if (isBusy)
        {
            <span class="btn-spinner"></span>
        }
        @Loc.T("auth.submit.login")
    </button>
</div>

@code {
    [Parameter]
    public EventCallback<string> ErrorMessage { get; set; }

    private string login = "";
    private string password = "";
    private bool rememberMe = true;
    private bool isBusy;

    private void PasswordChanged(string value) => password = value;

    private async Task DoLogin()
    {
        if (isBusy) return;
        await ErrorMessage.InvokeAsync("");

        if (string.IsNullOrWhiteSpace(login) || string.IsNullOrEmpty(password))
        {
            await ErrorMessage.InvokeAsync(Loc.T("auth.error.loginPassword"));
            return;
        }

        isBusy = true;
        var error = await AuthService.LoginAsync(login, password, rememberMe);
        isBusy = false;

        if (error is not null)
        {
            await ErrorMessage.InvokeAsync(Loc.T(error));
            return;
        }

        Nav.NavigateTo("/");
    }
}
